generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  idUsuario     Int          @id @default(autoincrement()) @map("id")
  email         String       @unique @db.VarChar(160)
  passwordHash  String       @db.VarChar(72)
  rol           String       @default("CLIENTE") @db.VarChar(20)
  suscripciones Suscripcion[] @relation("PropietarioSuscripcion")

  @@map("usuarios")
}

model Plan {
  planId                  Int                           @id @default(autoincrement()) @map("id")
  nombre                  String
  cantidadBolsas          Int
  precio                  Float
  frecuenciaEntrega       String
  fechaCreacion           DateTime                      @default(now())
  estado                  String                        @default("ACTUAL")
  remplazadoPorId         Int?
  suscripciones           Suscripcion[]
  solicitudesComoAnterior SolicitudCambioPlanSuscrito[] @relation("PlanAnterior")
  solicitudesComoNuevo    SolicitudCambioPlanSuscrito[] @relation("PlanNuevo")

  @@map("planes")
}

model Suscripcion {
  idSuscripcion      Int                           @id @default(autoincrement()) @map("id")
  plan               Plan                          @relation(fields: [planId], references: [planId])
  planId             Int                           @map("planId")
  diaSemana          String
  fechaInicio        DateTime                      @default(now())
  estadoSuscripcion  String
  // Nullable solo para registros anteriores cuyo propietario no se conoce.
  usuarioId          Int?
  usuario            Usuario? @relation("PropietarioSuscripcion", fields: [usuarioId], references: [idUsuario])
  direccionEntrega   DireccionEntrega?             @relation(fields: [IdDireccionEntrega], references: [idDireccionEntrega])
  IdDireccionEntrega Int?                          @map("IdDireccionEntrega")
  ciclos             Ciclo[]
  solicitudesCambio  SolicitudCambioPlanSuscrito[]

  @@index([usuarioId])
  @@map("suscripciones")
}

model DireccionEntrega {
  idDireccionEntrega Int           @id @default(autoincrement()) @map("id")
  calle              String
  codigoPostal       String
  numeroCasa         String
  estado             String
  suscripcion        Suscripcion[]

  @@map("direccionesEntrega")
}

model Ciclo {
  idCiclo         Int           @id @default(autoincrement()) @map("id")
  fechaProgramada DateTime
  numCiclo        Int
  entregaPausada  Boolean       @default(false)
  planIdAplicado  Int?
  precioAplicado  Float?
  suscripcionId   Int?
  suscripcion     Suscripcion? @relation(fields: [suscripcionId], references: [idSuscripcion])
  cobro           Cobro?        @relation(fields: [IdCobro], references: [idCobro])
  IdCobro         Int?          @map("IdCobro")
  entrega         Entrega?      @relation(fields: [IdEntrega], references: [idEntrega])
  IdEntrega       Int?          @map("IdEntrega")

  @@unique([suscripcionId, numCiclo])
  @@map("ciclos")
}

model Cobro {
  idCobro     Int      @id @default(autoincrement()) @map("id")
  fechaCobro  DateTime
  estadoCobro String
  ciclo       Ciclo[]

  @@map("cobros")
}

model Entrega {
  idEntrega     Int      @id @default(autoincrement()) @map("id")
  fechaEntrega  DateTime
  estadoEntrega String
  ciclo         Ciclo[]

  @@map("entregas")
}

model SolicitudCambioPlanSuscrito {
  idSolicitud     Int         @id @default(autoincrement()) @map("id")
  suscripcion     Suscripcion @relation(fields: [idSuscripcion], references: [idSuscripcion])
  idSuscripcion   Int         @map("idSuscripcion")
  planAnterior    Plan        @relation("PlanAnterior", fields: [idPlanAnterior], references: [planId])
  idPlanAnterior  Int         @map("idPlanAnterior")
  planNuevo       Plan        @relation("PlanNuevo", fields: [idPlanNuevo], references: [planId])
  idPlanNuevo     Int         @map("idPlanNuevo")
  fechaNuevoCiclo DateTime
  fechaSolicitud  DateTime    @default(now())
  fechaResolucion DateTime?
  estadoSolicitud String
  numCicloAplicacion Int @default(1)
  precioAnterior Float?
  precioNuevo Float?
  nombreAnterior String?
  nombreNuevo String?
  fechaAplicacion DateTime?

  @@map("solicitudCambioPlanSuscritos")
}
