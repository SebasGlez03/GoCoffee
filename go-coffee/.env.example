# Copia este archivo como .env y llena los valores. .env NO se sube a Git.

# Conexión a PostgreSQL (local):
DATABASE_URL="postgresql://postgres:CAMBIA_ESTA_PASSWORD@localhost:5432/go_coffee"
# Supabase (certificado público incluido; ejecutar desde la carpeta go-coffee):
# DATABASE_URL="postgresql://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres?sslmode=verify-full&sslrootcert=certs%2Fsupabase-ca.crt"

# Secreto para firmar los tokens. Obligatorio: sin él el servicio no arranca.
JWT_SECRET="CAMBIA_ESTE_SECRETO_POR_UNO_LARGO"
# Duración de la sesión (ej. 7d, 12h, 30m). Opcional, por defecto 7d.
JWT_EXPIRA_EN="7d"

# Puerto del servicio. Opcional, por defecto 3000.
PORT=3000

# Origen(es) del portal permitidos por CORS, separados por coma.
FRONTEND_URL="http://localhost:5173"
