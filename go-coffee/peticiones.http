@baseUrl = http://localhost:3000
@contentType = application/json
@token =

### 1) Registro admin
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "admin@go-coffee.com",
  "password": "123456",
  "rol": "ADMINISTRADOR"
}

### 2) Login admin
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "admin@go-coffee.com",
  "password": "123456"
}

### 3) Obtener perfil con token
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### 4) Registro cliente
POST {{baseUrl}}/auth/register
Content-Type: {{contentType}}

{
  "email": "cliente@go-coffee.com",
  "password": "123456",
  "rol": "CLIENTE"
}

### 5) Login cliente
POST {{baseUrl}}/auth/login
Content-Type: {{contentType}}

{
  "email": "cliente@go-coffee.com",
  "password": "123456"
}

### 6) Obtener todos los planes
GET {{baseUrl}}/planes

### 7) Crear un plan (solo admin)
POST {{baseUrl}}/planes
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "nombre": "Aficionado",
  "cantidadBolsas": 1,
  "precio": 250,
  "frecuenciaEntrega": "SEMANAL"
}

### 8) Obtener todas las suscripciones
GET {{baseUrl}}/suscripciones
Authorization: Bearer {{token}}

### 9) Crear una suscripción (cliente o admin)
POST {{baseUrl}}/suscripciones
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "planId": 1,
  "diaSemanaEntrega": "LUNES",
  "fechaInicio": "2026-11-05",
  "direccionEntrega": {
    "calle": "Av. Principal",
    "codigoPostal": "12345",
    "numeroCasa": "100",
    "estado": "CDMX"
  },
  "estadoSuscripcion": "ACTIVA",
  "ciclos": []
}

### 10) Obtener suscripción por ID
GET {{baseUrl}}/suscripciones/1
Authorization: Bearer {{token}}

### 11) Modificar suscripción
PATCH {{baseUrl}}/suscripciones/1
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "diaSemanaEntrega": "MARTES",
  "estadoSuscripcion": "PAUSADA"
}
### Ejemplos de estados válidos para estadoSuscripcion:
# ACTIVA | PAUSADA | SUSPENDIDA | CANCELADA

### Ejemplos de valores válidos para diaSemanaEntrega:
# LUNES | MARTES | MIERCOLES | JUEVES | VIERNES | SABADO | DOMINGO